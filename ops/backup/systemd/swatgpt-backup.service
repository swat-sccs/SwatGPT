[Unit]
Description=SwatGPT logical backup (MongoDB, Postgres, Qdrant, file volumes)
Documentation=file:///srv/SwatGPT/ops/backup/README.md
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
RequiresMountsFor=/srv/backup

[Service]
Type=oneshot
EnvironmentFile=/etc/swatgpt-backup.env
ExecStart=/srv/SwatGPT/ops/backup/backup.sh
TimeoutStartSec=2h
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
PrivateTmp=yes
NoNewPrivileges=yes
ProtectSystem=full
UMask=0077

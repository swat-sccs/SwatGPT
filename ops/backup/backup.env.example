# Install as /etc/swatgpt-backup.env (root:root, 0600). Read by swatgpt-backup.service and
# swatgpt-backup-verify.service. Every value shown is the script default.

# Deploy tree whose docker-compose.yml + docker-compose.override.yml define the live stack
# (the working directory of .github/workflows/production.yml).
COMPOSE_DIR=/srv/SwatGPT

# Dedicated backup disk (scsi1 on local-zfs, mounted at /srv/backup). backup.sh refuses to
# write to the root filesystem unless BACKUP_ALLOW_ROOTFS=1.
BACKUP_ROOT=/srv/backup/swatgpt
BACKUP_ALLOW_ROOTFS=0
BACKUP_MIN_FREE_MB=2048

# Retention: newest backup of each of the last KEEP_DAILY days, plus the newest backup of each
# of the last KEEP_WEEKLY ISO weeks.
KEEP_DAILY=14
KEEP_WEEKLY=8

# What to back up: mongo postgres qdrant files
BACKUP_COMPONENTS="mongo postgres qdrant files"

# node_exporter textfile collector directory (empty disables metrics).
TEXTFILE_DIR=/var/lib/node_exporter/textfile_collector

# Qdrant is published on 127.0.0.1:6333 by docker-compose.yml.
QDRANT_URL=http://127.0.0.1:6333
QDRANT_ALIAS=kb
QDRANT_API_KEY=

# Images for the weekly restore test (verify.sh); keep them in step with the live stack.
VERIFY_MONGO_IMAGE=mongo:8.0.20
VERIFY_POSTGRES_IMAGE=postgres:17-alpine
VERIFY_QDRANT_IMAGE=qdrant/qdrant:v1.15.1

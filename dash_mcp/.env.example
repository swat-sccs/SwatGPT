POSTGRES_DB=swatgpt
POSTGRES_USER=swatgpt
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgres://swatgpt:replace-with-a-long-random-password@swatgpt-postgres:5432/swatgpt

HOST=0.0.0.0
PORT=3000
MCP_ALLOWED_HOSTS=swatgpt-mcp,localhost,127.0.0.1
MCP_TOOL_TIMEOUT_MS=5000
HEALTHCHECK_PROBE_TIMEOUT_MS=4000
HEALTHCHECK_FAILURE_THRESHOLD=3
DASH_BASE_URL=https://dash.swarthmore.edu
UPSTREAM_TIMEOUT_MS=10000
UPSTREAM_RETRIES=2
UPSTREAM_CONCURRENCY=6

POLLING_ENABLED=true
ALERT_POLL_INTERVAL_SECONDS=60
REALTIME_POLL_INTERVAL_SECONDS=300
CONTENT_POLL_INTERVAL_SECONDS=900
CONFIG_POLL_INTERVAL_SECONDS=3600
OBSERVATION_RETENTION_DAYS=30
LOG_LEVEL=info
